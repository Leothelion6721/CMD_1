{
  "name": "advanced-terminal",
  "version": "1.0.0",
  "description": "Advanced Terminal - A modern terminal emulator with enhanced features",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron . --disable-gpu --disable-software-rasterizer",
    "dev": "electron . --dev --disable-gpu --disable-software-rasterizer",
    "build": "electron-builder",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "terminal",
    "emulator",
    "electron",
    "xterm",
    "advanced"
  ],
  "author": "Advanced Terminal Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/addon-unicode11": "^0.8.0"
  },
  "build": {
    "appId": "com.advancedterminal.app",
    "productName": "Advanced Terminal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
