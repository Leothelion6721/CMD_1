  "settings": {
    "defaultProfile": "PowerShell",
    "theme": "dark",
    "acrylic": false,
    "opacity": 1.0,
    "cursorBlink": true,
    "scrollback": 10000,
    "closeOnExit": true,
    "confirmCloseAllTabs": true,
    "copyOnSelect": false,
    "pasteWarning": true,
    "wordDelimiters": " /\\()\"'-.,:;<>~!@#$%^&*|+=[]{}~?\u2502",
    "initialCols": 120,
    "initialRows": 30,
    "bellStyle": "none",
    "enableWebGL": true,
    "smoothScrolling": true,
    "fastScrollModifier": "shift",
    "fastScrollSensitivity": 5,
    "linkModifier": "ctrl"
  },
  "keybindings": [
    {
      "command": "newTab",
      "keys": "ctrl+t"
    },
    {
      "command": "closeTab",
      "keys": "ctrl+w"
    },
    {
      "command": "nextTab",
      "keys": "ctrl+tab"
    },
    {
      "command": "prevTab",
      "keys": "ctrl+shift+tab"
    },
    {
      "command": "splitHorizontal",
      "keys": "ctrl+shift+h"
    },
    {
      "command": "splitVertical",
      "keys": "ctrl+shift+v"
    },
    {
      "command": "find",
      "keys": "ctrl+f"
    },
    {
      "command": "copy",
      "keys": "ctrl+c"
    },
    {
      "command": "paste",
      "keys": "ctrl+v"
    },
    {
      "command": "zoomIn",
      "keys": "ctrl+plus"
    },
    {
      "command": "zoomOut",
      "keys": "ctrl+minus"
    },
    {
      "command": "zoomReset",
      "keys": "ctrl+0"
    }
  ]
}
